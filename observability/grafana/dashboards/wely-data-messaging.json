  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "MongoDB (wely-chat, wely-events, wely-notifications)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
