    {
      "type": "timeseries",
      "title": "User events per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (event) (rate(keycloak_user_events_total{app=\"wely-auth\", error=\"\"}[$__rate_interval])) * 60",
          "legendFormat": "{{event}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "description": "Every user event Keycloak emits, by type: login, logout, refresh_token, code_to_token. Tagged by realm only — adding clientId would multiply the series by every client, which is why KC_EVENT_METRICS_USER_TAGS is left at its default.",
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
