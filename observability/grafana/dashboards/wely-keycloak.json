          },
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{app=\"wely-auth\"}[$__rate_interval]))",
          "legendFormat": "{{uri}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "description": "Quarkus templates the path, so one series covers every realm: /realms/{realm}/protocol/{protocol}/token is every token request of every environment. /metrics and /health/started are this dashboard's own scrapes and the kubelet's probes.",
      "id": 11,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
