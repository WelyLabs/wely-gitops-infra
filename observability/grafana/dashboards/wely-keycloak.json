{
  "uid": "wely-keycloak",
  "title": "Wely — Keycloak",
  "description": "The shared identity provider: who logged in, how long a token took, and whether its PostgreSQL kept up. One Keycloak serves every environment, one realm each, so a bad minute here is a bad minute everywhere.",
  "tags": [
    "wely"
  ],
  "editable": true,
  "schemaVersion": 41,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Authentication",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Logins",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(keycloak_user_events_total{app=\"wely-auth\", event=\"login\", error=\"\"}[$__range])) or vector(0)",
          "legendFormat": "over the range",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "description": "Successful logins over the selected range. The counter is created the first time the event happens, so an untouched realm has no series at all — hence the `or vector(0)`, which shows a truthful zero instead of 'No data'.",
      "id": 2,
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
