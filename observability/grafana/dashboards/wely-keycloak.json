            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (event, error) (rate(keycloak_user_events_total{app=\"wely-auth\", error!=\"\"}[$__rate_interval])) * 60",
          "legendFormat": "{{event}} — {{error}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "description": "The error label carries Keycloak's own reason: invalid_user_credentials, user_not_found, invalid_client_credentials. A flat line at zero is the normal case.",
