        "showPercentChange": false
      }
    },
    {
      "type": "stat",
      "title": "Password checks / min",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(keycloak_credentials_password_hashing_validations_total{app=\"wely-auth\"}[$__rate_interval])) * 60",
          "legendFormat": "hashing validations",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "description": "Argon2 or PBKDF2 validations per minute. Each one is deliberately expensive in CPU, which is why this is the metric that explains a slow Keycloak on two cores.",
      "id": 4,
      "gridPos": {
        "h": 5,
