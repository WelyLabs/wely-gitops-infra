    },
    {
      "type": "timeseries",
      "title": "Average latency by endpoint",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (uri) (rate(http_server_requests_seconds_sum{app=\"wely-auth\"}[$__rate_interval])) / sum by (uri) (rate(http_server_requests_seconds_count{app=\"wely-auth\"}[$__rate_interval]))",
          "legendFormat": "{{uri}} avg",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (uri) (http_server_requests_seconds_max{app=\"wely-auth\"})",
          "legendFormat": "{{uri}} max",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "description": "An average and a max, not a percentile: Quarkus publishes count, sum and max for this timer and no buckets, so there is nothing to run histogram_quantile on. The token endpoint's average is the number a login actually waits for.",
      "id": 12,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
