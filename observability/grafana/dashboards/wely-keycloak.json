            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Errors by status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status, uri) (rate(http_server_requests_seconds_count{app=\"wely-auth\", outcome=~\"CLIENT_ERROR|SERVER_ERROR\"}[$__rate_interval]))",
          "legendFormat": "{{status}} {{uri}}",
          "editorMode": "code",
          "range": true,
          "instant": false
