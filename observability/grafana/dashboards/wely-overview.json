      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 15
      }
    },
    {
      "type": "timeseries",
      "title": "p95 latency by service",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (app, le) (rate(http_server_requests_seconds_bucket{app=~\"$app\", node=~\"$node\", uri!~\"/actuator.*|/livez|/readyz\"}[$__rate_interval])))",
          "legendFormat": "{{app}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "95th percentile of request duration, from the SLO buckets (50ms, 100ms, 250ms, 500ms, 1s, 2.5s, 5s): the value is interpolated between two buckets, and anything above 5s reads as 5s.",
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 15
      }
    },
    {
      "type": "row",
      "id": 8,
      "title": "Technical errors",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Technical errors over the selected range",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "wely_errors_technical_total: every technical error the services answered or logged, by code (<PFX>-TEC-nnn) and source (request, outbox, consumer...).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (app, code, source) (increase(wely_errors_technical_total{app=~\"$app\", node=~\"$node\"}[$__range])) > 0",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "app": 0,
              "code": 1,
              "source": 2,
              "Value": 3
            },
            "renameByName": {
              "app": "Service",
              "code": "Code",
              "source": "Source",
              "Value": "Errors"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Errors",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": "",
          "countRows": false
        }
      },
      "id": 9,
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 0,
        "y": 24
      }
    },
    {
      "type": "timeseries",
      "title": "Technical errors",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (app, code, source) (increase(wely_errors_technical_total{app=~\"$app\", node=~\"$node\"}[$__rate_interval])) > 0",
          "legendFormat": "{{app}} {{code}} ({{source}})",
          "range": true,
