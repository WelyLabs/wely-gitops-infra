      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (app) (rate(http_server_requests_seconds_count{app=~\"$app\", node=~\"$node\", status=~\"4..\", uri!~\"/actuator.*|/livez|/readyz\"}[$__rate_interval]))",
          "legendFormat": "{{app}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
