        "x": 0,
        "y": 15
      }
    },
    {
      "type": "timeseries",
      "title": "5xx rate by service",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (app) (rate(http_server_requests_seconds_count{app=~\"$app\", node=~\"$node\", status=~\"5..\", uri!~\"/actuator.*|/livez|/readyz\"}[$__rate_interval]))",
          "legendFormat": "{{app}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
