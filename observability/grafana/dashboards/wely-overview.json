      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Technical errors per interval, by service, code and source.",
      "id": 10,
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 10,
        "y": 24
      }
    },
    {
      "type": "row",
      "id": 11,
